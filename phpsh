<?php 
date_default_timezone_set("utc");
ini_set('display_errors',1);
set_include_path(get_include_path() . PATH_SEPARATOR. dirname(__FILE__));
set_error_handler('phpsh_throw_error_exception',E_ALL);
register_shutdown_function('phpsh_on_shutdown');
define('DEFAULT_CRASH','phpsh_crash.hist');
define('DEFAULT_HIST','phpsh.hist');
define('MAIN_PROMPT','phpsh> ');
define('CONT_PROMPT','  ...> ');
$history = [];

if(isset($argv)) { // process arguments as php to execute
	foreach($argv as $arg) 
		if($arg != "-r") 
			phpsh_include($arg);
		else
			phpsh_include(DEFAULT_CRASH); 
}

if(is_callable("readline")) { // figure out our readline strategy
	print "# phpsh_readln -> readline\n";
	
	function phpsh_readln($prompt) { 
		return rtrim(readline($prompt)); 
	}
} else {
	print "# phpsh_readln -> /dev/stdin \n";
	print "# (add libreadline or libedit to your php runtime for a better experience!) \n";
	function phpsh_readln($prompt) {
		print $prompt;
		$fp=fopen("/dev/stdin", "r");
    	$input=fgets($fp, 4096);
    	fclose($fp);
    	return rtrim($input);
	}
}

print "# Enter .h for help\n\n";

phpsh_repl:
do { // main read-eval-print loop

	$entry = phpsh_read_entry();
	/* returns: 
	     null   | if the entry/line is empty => null
	     string | if the entry/line if starts w dot & is non-numeric 
	     array (w keys 'code' & 'last') | all other cases

	   So let's handle each case:  
     */
	
	if(empty($entry))                             // easy case!
		continue;

	if(is_string($entry) && $entry[0] == '.') {   // phpsh command
		phpsh_cmd(substr($entry,1));
		continue;
	}

	// otherwise we *should* have an array with keys 'code' & 'last' 
	if($entry['last'] == ';' || $entry['last'] == '}') { 
		// "instructions" statement or block definiton: no return Value
		$evalExp = $entry['code'];
		$type = 'instructions';
	} else if(isset($entry['code'])) {
		// expression: we want to display the value
		$evalExp = "return({$entry['code']});";
		$type = 'expression';
	} else {
		echo "🍅 unexpected entry",phpsh_showVar($entry),"\n";
		$evalExp = "\"🍅 can't process unexpected entry\"";
	}

	try {
		Phpsh::$_ = $_ = eval($evalExp);
		if($type == 'expression')
			echo phpsh_showVar($_),"\n"; 
		$history[] = $entry['code'];	
		if(function_exists('readline_add_history'))
			readline_add_history($entry['code']);
	} catch(ParseError $_e) {
		echo "CAUGHT parse error",$_e,"\n";
	} catch(\Throwable $_e) {
		echo "CAUGHT throwable ",$_e,"\n";
	}
	
} while(TRUE);


abstract class Phpsh {

	static $_;
	static $cwv;
	static $cwvrefpath = [];
	static $cwvstrpath = [];

	static function cwv($n=null) { 
		if($n===null) 
			return (self::$cwv === null) ? $GLOBALS : self::$cwv; 
		if($n == '..' || $n == '^') {
			array_pop(self::$cwvstrpath);
			return self::$cwv = array_pop(self::$cwvrefpath);
		}
		if($n[0] == '~' || $n[0] == '/') {
			self::$cwvrefpath = [];
			self::$cwvstrpath = [];
			if($n = substr($n,1)) {
				self::$cwv = $GLOBALS;
				return self::cwv($n);
			} else {
				self::$cwv = null;
				return true;
			}
		}
		if(is_object(self::$cwv)) {
			if(!isset(self::$cwv->$n)) 
				return false;	
			array_push(self::$cwvstrpath,"->$n");
			array_push(self::$cwvrefpath,self::$cwv->$n);
			return self::$cwv = self::$cwv->$n;	
		}
		if(is_array(self::$cwv)) {
			if(!isset(self::$cwv[$n])) 
				return false;	
			array_push(self::$cwvstrpath,"[$n]");
			array_push(self::$cwvrefpath,self::$cwv[$n]);
			return self::$cwv = self::$cwv[$n];	
		}
		return false;
	}

	static function pwv() { 
		return self::$cwv ? implode('',self::$cwvstrpath) : 'GLOBALS';
	}
} 


function phpsh_throw_error_exception($number = 0, $str = '',$file = null,$line = null) {
	throw new ErrorException($str, 0, $number, $file, $line);
	die("control flow shouldn't ever reach here");
}

function phpsh_line_analyze($line) {
	$brace_depth_chg = 0;
	$toks = token_get_all('<?php '.trim($line));
	foreach($toks as $t) {
		switch($t[0] ?? $t) {
			case '{': 
			case T_CURLY_OPEN: $brace_depth_chg++; break;
			//case T_CURLY_CLOSE: doesn't exist? What?
			case '}': $brace_depth_chg--; 
		}
	}
	return [
		'brace_depth_chg' => $brace_depth_chg,
		'last' => $t
	];
}

function phpsh_read_entry() {
	$line = phpsh_readln(MAIN_PROMPT);
	if(!isset($line[0]))
		return null;

	if(isset($line[0]) && $line[0] == '.' && !is_numeric($line[1])) 
		return $line;

	$brace_depth = 0;
	$done = false;
	do {
		$a = phpsh_line_analyze($line);
		$brace_depth += $a['brace_depth_chg'];
		$lines[] = $line;
		if($brace_depth == 0) {
			$done = true;
			$line = implode("\n",$lines);
		} else
			$line = phpsh_readln(CONT_PROMPT);
	} while (!$done);

	return [
		'last' => $a['last'],
		'code' => $line,
	];
}

function phpsh_cmd($cmdstr) {
	if(!$cmdstr) {
		echo "missing phpsh command\n";
		return false;
	}
	$cmd_parts = preg_split("/(?<!\\\\)\s+/",$cmdstr,-1,PREG_SPLIT_NO_EMPTY);

	$cmd = is_array($cmd_parts) ? $cmd_parts[0] : null;
	switch($cmd) {
		case 'q': 
			exit;
		case 's': 
			phpsh_cmd_save($cmd_parts[1] ?? null);
			break;
		case 'i':
		case 'l':
			$histfile = $cmd_parts[1] ?? DEFAULT_HIST;
			if(file_exists($histfile)) 
				phpsh_include($histfile);
			else 
				echo "can't find $histfile\n";
			break;
		case 'r':
			if(file_exists(DEFAULT_CRASH))
				phpsh_include(DEFAULT_CRASH);
			else 
				echo "can't find ",DEFAULT_CRASH,"\n";
			break;
		case 'v': 
			$cwv = Phpsh::cwv(isset($cmd_parts[1]) ? $cmd_parts[1] : null);
			echo "cwv: ",Phpsh::pwv(),"\n";
			echo phpsh_showVar($cwv),"\n";
			break;	
		case 'h': 
			phpsh_cmd_help();
			break;
		default:
			echo "`$cmd`: command not found (",count($cmd_parts) - 1," args ignored)\n";
			return false;
	}
	return true;
}

function phpsh_include($file) {
	if(preg_match('/phpsh$/',$file)) return true;
	echo "phpsh_include($file)\n";
	return file_exists($file) ? include_once($file) : false;
}

function phpsh_cols() { 
	return (int)(getenv('COLUMNS') ?: shell_exec('tput cols')); 
}

function phpsh_lsaa_str($aa,$maxlen=false) { 
	if(! count($aa) > 0) return '[]';
	$oneline = ($maxlen !== false);
	$entrysep = $oneline ? ', ' : ','.PHP_EOL.' ';
	$termcols = phpsh_cols();
	$entrychrload = strlen($entrysep)+2/*'key'*/+4/* => */+2/*''|[]*/;
	$sep = '';
	$rv = [];
	$entrieschrcount = 0;
	foreach($aa as $k => $v) {
		$entrychrloadwkey = strlen($k) + $entrychrload;
		$vstr = phpsh_showVar($v, $termcols - $entrychrloadwkey);
		if($oneline && ($maxlen <= $entrieschrcount + $entrychrloadwkey)) {
			// we don't even have room for the key before we run over cols
			array_push($rv,$sep,"'…' => '…'");
			break;
		}
		if($oneline && ($maxlen <= $entrieschrcount + $entrychrloadwkey + strlen($vstr))) {
			// we have room for the key but not the value before we run over
			array_push($rv,$sep,"'",$k,"' => '…'");
			break;
		}
		// we have room for the whole entry!
		array_push($rv,$sep,"'",$k,"' => ",$vstr);
		$sep = $entrysep;
		$entrieschrcount += $entrychrloadwkey + strlen($vstr);
	}
	array_push($rv,$oneline ? '' : PHP_EOL,']');
	$rv = "[ ".implode('',$rv);
	return $rv;
}

function phpsh_showVar($v,$maxlen=false) {
	// if(is_object($v) && method_exists($v,'__to_string')) 
	//	return $v->__toString();
	// $rv = '(phpsh doesn\'t know how to string-ify this variable or result)';
	
	if(is_object($v)) {
		$clsname = get_class($v); 
		return "$clsname(".phpsh_showVar(
			(array)$v,
			max($maxlen - strlen($clsname) - 2/*()*/,0) ?: false
		).')';
	}

	if(is_array($v)) 
		return phpsh_lsaa_str($v,$maxlen);

	if($v === null) 
		return "null";

	$vrep = var_export($v,true);
	return (!is_string($v) || !($maxlen) || $maxlen >= strlen($vrep)) ? 
		$vrep : substr($vrep,0,$maxlen-2)."…'";
}

function phpsh_cmd_save($filename,$avoid_last=false) {
	global $history;
	if(!$filename) {
		$filename = DEFAULT_HIST;
		echo "save command .s needs target file, using ",DEFAULT_HIST," in current working directory ",getcwd(),"\n";
	} 
	if($avoid_last) 
		array_pop($history);
	$output = "<?php \n\n".implode(";\n",$history).";";
	if(!file_put_contents($filename,$output))
		echo "error writing file $filename\n";
	else
		echo "saved history to $filename\n";
}

function phpsh_cmd_help() {
	$default_crash = DEFAULT_CRASH;
	echo <<<EOD
Available phpsh commands:
  .h       - prints this command list
  .s <arg> - saves command history to filename <arg>
  .i <arg> - shortcut for include(<arg>)
  .l <arg> - shortcut for include(<arg>)
  .r       - shortcut for include("$default_crash")
  .q       - quit

All other input is simply filtered through PHP's `eval` function. phpsh will attempt to automatically yield a string representation of entries that don't end with a semi-colon or a block delimiter. The last result is stored in the \$_ variable, as in perl or python. 

The representation returned attempts to combine human-readability with valid php representation, one line per key of an array or property of an object. However, if the representation of an array or property value exceeds the line width, phpsh attempts to truncate it in a reasonable manner, indicated with UTF ellipses `…`.

EOD;
}

function phpsh_on_shutdown() {
	$err = error_get_last();	
	if($err && ($err['type'] === E_ERROR)) {
		phpsh_cmd_save(DEFAULT_CRASH);
		echo "history saved to ",DEFAULT_CRASH,", use .r on next run to replay";
	}
	echo "\n";
}
